# LLM Configuration (Model-Agnostic)
# Supported providers: ollama, google-genai, openai, anthropic
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2

# For Google Gemini (if using google-genai provider)
GOOGLE_API_KEY=your_google_api_key_here

# For OpenAI (if using openai provider)
OPENAI_API_KEY=your_openai_api_key_here

# For Anthropic (if using anthropic provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama Configuration (if using ollama provider)
OLLAMA_BASE_URL=http://localhost:11434

# Agent Configuration
MAX_TOPICS=10
MAX_SEARCH_RESULTS=10
LOG_LEVEL=INFO


# DEFAULT_MODEL_PROVIDER=gemini
# GOOGLE_API_KEY=your_google_api_key_here

OLLAMA_MODEL= "gpt-oss:120b-cloud"
MAX_REVISIONS=2
ARTICLE_MIN_WORDS=1500
ARTICLE_MAX_WORDS=2500

LOG_LEVEL="INFO"

